      "$ref": "#/$defs/facts"
     },
     "definition_facts": {
      "$ref": "#/$defs/facts"
     },
     "misplaced": {
      "$ref": "#/$defs/facts"
     },
     "relations": {
      "type": "object",
      "properties": {
       "out": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "relation": {
           "$ref": "#/$defs/relation"
          },
          "label": {
           "type": "string"
          },
          "concept": {
           "$ref": "#/$defs/concept"
          },
          "name": {
           "type": "string"
          }
         },
         "required": [
          "relation",
          "label",
          "concept",
          "name"
         ],
         "additionalProperties": false
        }
       },
       "in": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "relation": {
           "$ref": "#/$defs/relation"
          },
          "label": {
           "type": "string"
          },
          "concept": {
           "$ref": "#/$defs/concept"
          },
          "name": {
           "type": "string"
          }
         },
         "required": [
          "relation",
          "label",
          "concept",
          "name"
         ],
         "additionalProperties": false
        }
       }
      },
      "required": [
       "out",
       "in"
      ],
      "additionalProperties": false
     },
     "lectures": {
      "$ref": "#/$defs/lectures"
     },
     "merged": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "segment_concept": {
         "type": "string",
         "pattern": "^(?:\\d+[a-z]?|tut_\\d+(?:_part\\d+)?)/S\\d+/C\\d+$"
        },
        "name": {
         "type": "string"
        },
        "how": {
         "type": "string"
        },
        "reason": {
         "type": "string"
        }
       },
       "required": [
        "segment_concept",
        "name",
        "how",
        "reason"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "name",
     "aliases",
     "acronyms",
     "definition",
     "defined",
     "defined_in",
     "first_defined",
     "facts",
     "defining_facts",
     "definition_facts",
     "misplaced",
     "relations",
     "lectures",
     "merged"
    ],
    "additionalProperties": false
   },
   "x-key-id": "concept"
  },
