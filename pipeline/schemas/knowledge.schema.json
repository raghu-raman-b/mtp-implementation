{
 "$comment": "The knowledge layer (output/<course>/knowledge/), checked by scripts/schema_check.py, which supports only the keywords used here. x-ref marks a string that refers to an ID of a kind, x-id a string that defines one; x-key-id and x-key-ref do the same for the keys of an object. Sentence IDs are defined by the first..last range of each segment in lectures/*.json. x-files names the definition each file of the layer is checked against.",
 "x-files": {
  "index.json": "index_file",
  "names.json": "names_file",
  "concepts.json": "concepts_file",
  "relations.json": "relations_file",
  "facts.json": "facts_file",
  "fact_embeddings.json": "embeddings_file",
  "lectures/*.json": "lecture_file",
  "goals.json": "goals_file",
  "lecture_graph.json": "lecture_graph_file",
  "assumed.json": "assumed_file"
 },
 "$defs": {
  "lecture": {
   "type": "string",
   "pattern": "^(?:\\d+[a-z]?|tut_\\d+(?:_part\\d+)?)$",
   "x-ref": "lecture"
  },
  "segment": {
   "type": "string",
   "pattern": "^(?:\\d+[a-z]?|tut_\\d+(?:_part\\d+)?)/S\\d+$",
   "x-ref": "segment"
  },
  "fact": {
   "type": "string",
   "pattern": "^(?:\\d+[a-z]?|tut_\\d+(?:_part\\d+)?)/S\\d+/F\\d+$",
   "x-ref": "fact"
  },
  "sentence": {
   "type": "string",
   "pattern": "^(?:\\d+[a-z]?|tut_\\d+(?:_part\\d+)?)/\\d+$",
   "x-ref": "sentence"
  },
  "concept": {
   "type": "string",
   "pattern": "^C\\d{4,}$",
   "x-ref": "concept"
  },
  "relation": {
   "type": "string",
   "pattern": "^R\\d{4,}$",
   "x-ref": "relation"
  },
  "objective": {
   "type": "string",
   "pattern": "^(?:\\d+[a-z]?|tut_\\d+(?:_part\\d+)?)/O\\d+$",
   "x-ref": "objective"
  },
  "lecture_goal": {
   "type": "string",
   "pattern": "^(?:\\d+[a-z]?|tut_\\d+(?:_part\\d+)?)/G$",
   "x-ref": "lecture_goal"
  },
  "course_goal": {
   "type": "string",
   "pattern": "^G\\d+$",
   "x-ref": "course_goal"
  },
  "lectures": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/lecture"
   }
  },
  "segments": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/segment"
   }
  },
  "facts": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/fact"
   }
  },
  "concepts": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/concept"
   }
  },
  "concept_kinds": {
   "type": "object",
   "properties": {
    "introduced": {
     "$ref": "#/$defs/concepts"
    },
    "met_again": {
     "$ref": "#/$defs/concepts"
    },
    "defined_later": {
     "$ref": "#/$defs/concepts"
    },
    "assumed": {
     "$ref": "#/$defs/concepts"
    }
   },
   "required": [
    "introduced",
    "met_again",
    "defined_later",
    "assumed"
   ],
   "additionalProperties": false
  },
  "prerequisites": {
   "type": "object",
   "properties": {
    "direct": {
     "$ref": "#/$defs/lectures"
    },
    "all": {
     "$ref": "#/$defs/lectures"
    }
   },
   "required": [
    "direct",
    "all"
   ],
   "additionalProperties": false
  },
  "index_file": {
