 "goal": {
  "id": "45/G",
  "goal": "Plan an empirical usability evaluation for an implemented XR system by outlining its stages and designing a testable experiment with measurable research questions and variables.",
  "achieves": "It supports the course aim of implementing XR systems with confidence by showing how to move from code testing to an objective, structured usability evaluation for an XR system."
 },
 "objectives": [
  {
   "id": "45/O1",
   "goal": "Describe the role of empirical usability evaluation in system implementation and the requirements and stages of a full usability study.",
   "achieves": "It lets the learner recognize when empirical evaluation is needed after code testing and understand the structure of a full usability study before designing its experiments.",
   "segments": [
    "45/S0",
    "45/S1",
    "45/S2"
   ]
  },
  {
   "id": "45/O2",
   "goal": "Design an empirical usability experiment by turning broad usability concerns into testable, measurable research questions and identifying the relevant variables and levels.",
   "achieves": "It enables the learner to specify what will be measured in an XR usability evaluation and how the test conditions support objective conclusions.",
   "segments": [
    "45/S3",
    "45/S4",
    "45/S5",
    "45/S6"
   ]
  }
