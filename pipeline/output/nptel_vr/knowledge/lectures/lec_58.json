 "goal": {
  "id": "58/G",
  "goal": "Explain why VR rendering is computationally demanding and how VR software architectures and GPU parallelism support its efficient implementation.",
  "achieves": "It gives the learner a foundation for analyzing resource requirements and optimization strategies when developing an XR system."
 },
 "objectives": [
  {
   "id": "58/O1",
   "goal": "Explain how the 3D graphics pipeline, rasterization of points and lines, and VR content requirements such as anti-aliasing and dynamic realism increase rendering computational complexity.",
