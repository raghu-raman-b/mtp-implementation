 "goal": {
  "id": "20/G",
  "goal": "Explain the VR software landscape, including virtual world generator capabilities, development tools and game engines, and native and web deployment options.",
  "achieves": "It gives the learner the foundational understanding needed to select and use VR software tools when implementing an XR system in the course case study."
 },
 "objectives": [
  {
   "id": "20/O1",
   "goal": "Explain the functional capabilities a virtual world generator must provide for realistic and socially interactive virtual worlds.",
   "achieves": "It lets the learner identify the physics, collision, environmental, and networked collaborative support required for believable VR experiences.",
   "segments": [
    "20/S0",
    "20/S1"
   ]
  },
  {
   "id": "20/O2",
   "goal": "Describe how VR software development is organized, from choosing between SDKs and ready-made virtual world generators to using game engines with their development environments and core rendering, audio, and physics components.",
   "achieves": "It lets the learner understand the major development tools and middleware services available for building VR applications and evaluate popular engines such as Unity and Unreal.",
   "segments": [
    "20/S2",
    "20/S3",
    "20/S4"
   ]
  },
  {
   "id": "20/O3",
   "goal": "Describe how VR applications are deployed natively or over the web, distinguishing major native VR SDKs from web deployment tools and platforms.",
   "achieves": "It lets the learner plan the platform, SDK, or web toolchain needed to deliver a VR application and assess local versus web-based delivery.",
   "segments": [
    "20/S5",
    "20/S6"
   ]
  }
 ],
