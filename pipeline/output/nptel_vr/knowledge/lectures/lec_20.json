 "goal": {
  "id": "20/G",
  "goal": "Describe the software foundation of VR systems, including the core capabilities of virtual world generators, the development platforms used to build VR applications, and the native and web deployment methods.",
  "achieves": "Provides the foundational software knowledge needed to select, implement, and deliver an XR system with confidence in the course's practical case study."
 },
 "objectives": [
  {
   "id": "20/O1",
   "goal": "Explain what physics and networked collaborative support in a virtual world generator must provide for realistic motion, collisions, and shared social interaction.",
   "achieves": "Gives the learner a basis for evaluating the core interactive services needed when designing or implementing a VR system.",
   "segments": [
    "20/S0",
    "20/S1"
   ]
  },
  {
   "id": "20/O2",
   "goal": "Explain the software platforms used to build VR experiences, from SDKs and ready-made virtual world generators to game engines with their rendering, audio, and physics components and examples.",
   "achieves": "Lets the learner understand the development toolchain needed to implement a VR application in the course's system-development case study.",
   "segments": [
    "20/S2",
    "20/S3",
    "20/S4"
   ]
  },
  {
   "id": "20/O3",
   "goal": "Describe the native and web deployment pathways for VR applications, including head-mounted display SDKs, web development tools, and cloud rendering options.",
   "achieves": "Enables the learner to plan how a VR application will be delivered on relevant hardware and platforms in an XR project.",
   "segments": [
    "20/S5",
    "20/S6"
   ]
  }
 ],
