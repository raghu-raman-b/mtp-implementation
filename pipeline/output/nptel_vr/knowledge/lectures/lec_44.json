 "goal": {
  "id": "44/G",
  "goal": "Describe how the Majuli VR Tour was implemented for head-mounted and mobile devices and how its user experience is evaluated using post-task, post-session, and cybersickness questionnaires.",
  "achieves": "Provides the learner with a concrete example of moving from an XR system design to implemented demos and evaluation instruments, supporting the course's aim to understand and implement XR systems with confidence."
 },
 "objectives": [
  {
   "id": "44/O1",
   "goal": "Explain how self-report questionnaires are used to evaluate usability and XR discomfort, including post-task, post-session, and simulator-sickness instruments.",
   "achieves": "Gives the learner a practical set of evaluation measures for judging whether an XR system is usable, satisfying, and comfortable, supporting user-centered implementation and later optimization.",
   "segments": [
    "44/S0",
    "44/S1",
    "44/S2",
    "44/S3"
   ]
  },
  {
   "id": "44/O2",
   "goal": "Summarize how the Majuli VR Tour was implemented for Oculus Quest and Google Cardboard and what user-experience flows and features those demos provide.",
   "achieves": "Connects the case-study system design to concrete device-specific implementations and demo interactions, helping the learner understand how an XR system can be built and tested on real hardware.",
   "segments": [
    "44/S4",
    "44/S5"
   ]
  }
 ],
