 "goal": {
  "id": "14/G",
  "goal": "Describe the main hardware components of a VR system, including non-hand input methods, the processing component, and visual and non-visual output devices.",
  "achieves": "Provides the foundational XR hardware knowledge needed to understand, evaluate, and implement a VR system within the course's practical development approach."
 },
 "objectives": [
  {
   "id": "14/O1",
   "goal": "Explain the non-hand input techniques used in VR, including the categories of full-body tracking and sound-based tracking.",
   "achieves": "Gives the learner a basis for understanding how VR systems capture user motion and voice to support interaction, embodiment, and social presence in later XR design.",
   "segments": [
    "14/S0"
   ]
  },
  {
   "id": "14/O2",
   "goal": "Describe the processing/computer component of a VR system, including selection factors and the roles of GPU, CPU, and RAM.",
   "achieves": "Enables the learner to evaluate computing platforms and understand the hardware constraints of VR rendering and application development.",
   "segments": [
    "14/S1"
   ]
  },
  {
   "id": "14/O3",
   "goal": "Describe the main VR output devices, covering visual displays and non-visual audio, haptic, and motion-based outputs.",
   "achieves": "Helps the learner understand how output hardware shapes immersion, sensory feedback, and motion-related user experience for later XR optimization and implementation.",
