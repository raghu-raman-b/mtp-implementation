 "goal": {
  "id": "14/G",
  "goal": "Explain the main hardware elements of virtual reality systems, from non-hand input to processing and output devices, and how each supports immersion and interaction.",
  "achieves": "Provides the foundational VR hardware knowledge needed to understand later XR topics and to evaluate hardware choices for immersive systems."
 },
 "objectives": [
  {
   "id": "14/O1",
   "goal": "Explain how virtual reality systems capture user input without hand controllers, including full-body tracking and sound-based tracking methods.",
   "achieves": "Gives the learner a basis for identifying non-hand input hardware and understanding how movement and sound are captured in VR applications.",
   "segments": [
    "14/S0"
   ]
  },
  {
   "id": "14/O2",
   "goal": "Describe the processing component of virtual reality systems and how the GPU, CPU, and RAM support rendering and system performance.",
   "achieves": "Lets the learner understand the computational requirements of VR and the factors that matter when choosing a processing platform or middleware.",
   "segments": [
    "14/S1"
   ]
  },
  {
   "id": "14/O3",
   "goal": "Describe the main output devices of virtual reality systems and how visual displays and non-visual sensory devices support immersion.",
   "achieves": "Enables the learner to evaluate how different displays and sensory feedback technologies affect presence, usability, and the overall XR experience.",
   "segments": [
    "14/S2",
    "14/S3"
   ]
  }
 ],
