 "goal": {
  "id": "9/G",
  "goal": "Explain the major issues and challenges of VR and AR, from the ambiguity of presence and fidelity constraints in VR to the display, interaction, and pose registration/tracking challenges in AR.",
  "achieves": "It provides a foundation for understanding the user-facing and technological limitations of XR systems, supporting later design and implementation of XR applications."
 },
 "objectives": [
  {
   "id": "9/O1",
   "goal": "Explain why the goal of presence in VR is ambiguous and how the uncanny valley effect, together with representational, interaction, and experiential fidelity, shapes design trade-offs for realistic VR experiences.",
   "achieves": "It lets the learner evaluate VR experiences and design decisions by understanding the perceptual and experiential constraints that affect presence and immersion.",
   "segments": [
    "9/S0",
    "9/S1",
    "9/S2"
   ]
  },
  {
   "id": "9/O2",
   "goal": "Describe the main technological challenges of AR systems across display technology, interaction modalities, and three-dimensional pose registration and tracking.",
   "achieves": "It lets the learner identify the technical problems an AR developer must address to align and sustain virtual content within the real environment.",
   "segments": [
    "9/S3"
   ]
  }
 ],
