 "goal": {
  "id": "38/G",
  "goal": "Explain the system-design approach for extended reality systems by framing interface and interaction design, using generic usability guidelines, and classifying XR interaction categories.",
  "achieves": "Prepares the learner to define a usable interface and interaction model for the course case study before system implementation and optimization."
 },
 "objectives": [
  {
   "id": "38/O1",
   "goal": "Explain why XR system design focuses on interface and interaction design rather than code design and describe the basic design languages used to begin and represent design ideas.",
   "achieves": "Gives the learner the design-stage frame needed to follow the case-study system design and later evaluate its interface and interaction choices.",
   "segments": [
    "38/S0",
    "38/S1"
   ]
  },
  {
   "id": "38/O2",
   "goal": "Evaluate interface and interaction design choices in extended reality systems using Ben Shneiderman's Eight Golden Rules as generic design guidelines.",
   "achieves": "Supports the course's system-development aim by letting the learner justify usable design decisions and identify usability risks before implementing the XR case study.",
   "segments": [
    "38/S2",
    "38/S3",
    "38/S4",
    "38/S5",
    "38/S6"
   ]
  },
  {
   "id": "38/O3",
   "goal": "Identify the broad categories of extended reality interaction as object interaction, navigation, and interaction for system control.",
   "achieves": "Gives the learner a classification for describing and later implementing navigation, object manipulation, and system-control interactions in the course case study.",
   "segments": [
    "38/S7"
   ]
  }
 ],
