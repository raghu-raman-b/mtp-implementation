 "goal": {
  "id": "38/G",
  "goal": "Explain how to conduct interface and interaction design for an XR system, using the design stage, generic usability rules, and broad interaction categories.",
  "achieves": "Enables the learner to plan the interface and interaction design of an XR system before implementation in the course case study."
 },
 "objectives": [
  {
   "id": "38/O1",
   "goal": "Describe the initial interface and interaction design process for an XR system, including why it is distinct from code design and how design ideas are represented.",
   "achieves": "Gives the learner a starting point for turning the design stage into representable design ideas that can be prototyped and evaluated.",
   "segments": [
    "38/S0",
    "38/S1"
   ]
  },
  {
   "id": "38/O2",
   "goal": "Explain how generic interface design guidelines, especially Shneiderman's Eight Golden Rules, apply to XR interface and interaction design.",
   "achieves": "Gives the learner usability criteria to evaluate XR interfaces and make design improvements during the system design stage.",
   "segments": [
    "38/S2",
    "38/S3",
    "38/S4",
    "38/S5",
    "38/S6"
   ]
  },
  {
   "id": "38/O3",
   "goal": "Identify the broad categories of XR interaction, including object interaction, navigation, and system control.",
