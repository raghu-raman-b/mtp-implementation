 "goal": {
  "id": "12/G",
  "goal": "Explain the evaluation and mitigation of cybersickness in XR systems, including machine-learning evaluation categories, the presence trade-off, and developer- and user-side countermeasures.",
  "achieves": "Gives the learner a foundational ability to recognize, assess, and reduce a major XR challenge, preparing them to use or develop immersive applications more safely and effectively."
 },
 "objectives": [
  {
   "id": "12/O1",
   "goal": "Classify machine-learning-based cybersickness evaluation approaches by model interpretability and by whether they detect or predict sickness as classes or sickness scores.",
   "achieves": "Supports the course’s treatment of XR issues and challenges by enabling the learner to interpret and compare cybersickness evaluation methods when assessing immersive system experiences.",
   "segments": [
    "12/S0",
    "12/S1"
   ]
  },
  {
   "id": "12/O2",
   "goal": "Describe how cybersickness mitigation involves a presence trade-off and compare developer-side and user-side countermeasures for reducing cybersickness.",
   "achieves": "Lets the learner address a key psycho-physiological issue when using or designing XR systems, serving the course aim of understanding and implementing XR systems with confidence.",
   "segments": [
    "12/S2",
    "12/S3",
    "12/S4"
   ]
  }
