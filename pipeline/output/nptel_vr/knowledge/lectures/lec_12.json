 "goal": {
  "id": "12/G",
  "goal": "Explain how cybersickness is evaluated and mitigated in XR systems, using machine-learning-based detection or prediction methods and developer- or user-side countermeasures that balance presence.",
  "achieves": "It gives the learner a foundation for addressing a key psycho-physiological issue in XR, so they can choose sickness-evaluation methods and apply countermeasures with confidence when understanding or implementing XR systems."
 },
 "objectives": [
  {
   "id": "12/O1",
   "goal": "Explain how machine-learning-based cybersickness evaluation methods are characterized by their task, output type, and model interpretability.",
   "achieves": "It lets the learner understand what sickness-monitoring options are available when evaluating or developing an XR system and how to interpret their results.",
   "segments": [
    "12/S0",
    "12/S1"
   ]
  },
  {
   "id": "12/O2",
   "goal": "Explain how cybersickness is mitigated in XR by balancing presence against comfort, including developer-side and user-side countermeasures.",
