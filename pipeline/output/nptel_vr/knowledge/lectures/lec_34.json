 "goal": {
  "id": "34/G",
  "goal": "Explain the Majuli Island virtual reality heritage preservation case study as a practical XR problem, from its main concerns and heritage-capture scope to the challenges of building an immersive interactive VR tour from its multimodal archive.",
  "achieves": "Provides the shared case-study context and problem definition needed to understand and implement an XR system with confidence in the later course lectures."
 },
 "objectives": [
  {
   "id": "34/O1",
   "goal": "Characterize the main concerns and issues of the Majuli Island virtual reality heritage preservation and tour project.",
   "achieves": "Gives the learner a shared understanding of the practical problem and user-experience constraints that later XR development work must address.",
   "segments": [
    "34/S0"
   ]
  },
  {
   "id": "34/O2",
   "goal": "Describe how Majuli's tangible and intangible cultural heritage is organized into 24 hotspots for systematic heritage capture and documented as a multimodal heritage archive.",
   "achieves": "Provides the concrete heritage-content and data model that later requirements, design, implementation, and optimization stages must handle.",
   "segments": [
    "34/S1",
    "34/S2",
    "34/S3"
   ]
  },
  {
   "id": "34/O3",
   "goal": "Identify the key challenges in building an immersive interactive Majuli VR tour from the archival heritage information, including user requirements, design, usability testing, code testing, and cybersickness.",
