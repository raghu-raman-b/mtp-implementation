 "goal": {
  "id": "26/G",
  "goal": "Explain the perceptual and proprioceptive processes that shape XR experience and how sensory mismatches can cause cybersickness or presence loss.",
  "achieves": "Provides the human-factor foundation needed in the course to understand XR sensory systems and to evaluate or design XR experiences with reduced discomfort and greater presence."
 },
 "objectives": [
  {
   "id": "26/O1",
   "goal": "Explain the human perceptual process by which sensory signals are received, neurally transmitted, hierarchically processed, and combined with memory to form interpreted perception.",
   "achieves": "Equips the learner to interpret later course material on XR visual, auditory, and other sensory systems by establishing how raw sensory input becomes perceived experience.",
   "segments": [
    "26/S0",
    "26/S1",
    "26/S2",
    "26/S3"
   ]
  },
  {
   "id": "26/O2",
   "goal": "Explain how proprioception contributes to body-aware perception and how sensory conflicts in XR can cause cybersickness or presence loss, including design implications from vection.",
   "achieves": "Enables the learner to connect human bodily perception to XR comfort issues and to recognize design constraints for reducing cybersickness and supporting presence.",
   "segments": [
    "26/S4",
    "26/S5"
   ]
  }
 ],
