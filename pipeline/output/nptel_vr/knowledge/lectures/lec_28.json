 "goal": {
  "id": "28/G",
  "goal": "Explain how human visual perception of XR scenes, from optical image formation to depth and motion, determines XR display requirements for resolution, intensity, and frame rate.",
  "achieves": "Provides the foundational human-factors and display knowledge needed to understand XR visual hardware, address psycho-physiological issues, and later design or optimize XR systems with confidence."
 },
 "objectives": [
  {
   "id": "28/O1",
   "goal": "Explain how human-eye optics and VR headset lens setups form a real image on the retina that is perceived as a virtual image.",
   "achieves": "Gives the learner a physiological and optical foundation for understanding VR display hardware and why engineered lenses are needed to project virtual scenes onto the retina.",
   "segments": [
    "28/S0"
   ]
  },
  {
   "id": "28/O2",
   "goal": "Describe the perceptual mechanisms that allow depth and motion to be experienced in three-dimensional XR scenes.",
   "achieves": "Helps the learner understand the human-factors basis of immersion and spatial interaction, preparing them to evaluate how XR experiences represent and move through virtual space.",
   "segments": [
    "28/S1",
    "28/S2"
   ]
  },
  {
   "id": "28/O3",
   "goal": "Relate human visual perception constraints to XR display requirements for spatial resolution, intensity, and temporal resolution.",
   "achieves": "Enables the learner to understand the criteria for resolution, brightness, and frame rate in XR displays and to recognize perceptual artifacts such as aliasing and the screen-door effect when evaluating or optimizing displays.",
   "segments": [
    "28/S3"
   ]
  }
 ],
