 "goal": {
  "id": "11/G",
  "goal": "Explain how cybersickness in virtual environments arises and how its occurrence and severity can be measured and evaluated.",
  "achieves": "It gives the learner foundational knowledge for identifying discomfort risks and selecting appropriate assessment methods when designing, implementing, or optimizing an XR system."
 },
 "objectives": [
  {
   "id": "11/O1",
   "goal": "Explain how visual motion, locomotion methods, control, display and content characteristics, and exposure factors influence the onset and severity of cybersickness in virtual environments.",
   "achieves": "It helps the learner understand a key psycho-physiological issue and anticipate which VR design or content choices may increase user discomfort.",
   "segments": [
    "11/S0",
    "11/S1",
    "11/S2",
    "11/S3"
   ]
  },
  {
   "id": "11/O2",
   "goal": "Describe the input-process-output framework for measuring cybersickness, its four input categories, and the distinction between manual and machine-learning-based evaluation.",
   "achieves": "It enables the learner to choose and interpret sickness questionnaires, physiological signals, behavioral measures, and model-based assessments when evaluating an XR experience.",
   "segments": [
    "11/S4",
    "11/S5",
    "11/S6",
    "11/S7"
   ]
  }
 ],
