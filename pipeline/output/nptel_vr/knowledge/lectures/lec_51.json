 "goal": {
  "id": "51/G",
  "goal": "Apply cybersickness-aware optimization to semi-interactive VR tours by formulating exposure-limited path problems and solving the minimum-time all-POI case as a time-weighted travelling salesman problem.",
  "achieves": "Give the learner a foundational method for reducing cybersickness through VR navigation-time optimization, supporting the course's aim to design and implement optimized XR systems."
 },
 "objectives": [
  {
