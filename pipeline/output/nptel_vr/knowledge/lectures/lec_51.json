 "goal": {
  "id": "51/G",
  "goal": "Explain how to convert a minimum-time all-POI VR tour into a time-weighted travelling-salesman problem and recover a valid path that limits exposure duration to reduce cybersickness.",
  "achieves": "It gives the learner an optimization approach for VR navigation that can be used to analyze or design virtual tour experiences in the course's XR system-development and optimization work."
 },
 "objectives": [
  {
   "id": "51/O1",
   "goal": "Describe how cybersickness-related exposure-duration limits in semi-interactive VR tours lead to POI path-optimization problems.",
   "achieves": "It gives the learner the user-experience criterion needed to evaluate and constrain VR navigation design in the course's optimization topics.",
   "segments": [
    "51/S0",
    "51/S1",
    "51/S2"
   ]
  },
  {
   "id": "51/O2",
   "goal": "Model the minimum-time all-POI VR tour as a weighted graph whose edge weights are travel times estimated by the natural walking-speed model.",
   "achieves": "It gives the learner a quantitative navigation model that can be used to compare and optimize virtual tour routes in the course's XR development case study.",
   "segments": [
    "51/S3",
    "51/S4"
   ]
  },
  {
   "id": "51/O3",
   "goal": "Transform the minimum-time POI tour into a complete time-weighted travelling-salesman problem and describe how to recover a valid original-graph path while respecting a cybersickness time threshold.",
   "achieves": "It lets the learner apply a standard graph-optimization method to generate VR navigation paths that reduce exposure time, supporting the course's aim of implementing XR systems with optimization-aware design.",
   "segments": [
    "51/S5",
    "51/S6"
   ]
  }
 ],
