 "goal": {
  "id": "27/G",
  "goal": "Explain how the behavior of light and the physiology of the human eye shape visual perception and inform VR headset design, rendering, camera placement, and tracking.",
  "achieves": "It provides the foundational human-factors knowledge needed to understand and later implement XR systems with confidence."
 },
 "objectives": [
  {
   "id": "27/O1",
   "goal": "Explain why visual perception, light propagation, and lenses are important for VR headset design, virtual world rendering, camera placement, and tracking.",
   "achieves": "It connects the lecture’s optical and perceptual concepts to concrete XR system design and implementation issues.",
   "segments": [
    "27/S0"
   ]
  },
  {
   "id": "27/O2",
   "goal": "Describe how the photon, wave, and ray models of light, surface interaction, and reflected light intensity determine perceived color.",
   "achieves": "It gives the learner an optical basis for understanding rendering, display, and color representation in XR systems.",
   "segments": [
    "27/S1",
    "27/S2",
    "27/S3"
   ]
  },
  {
   "id": "27/O3",
   "goal": "Describe how human eye anatomy, visible light, and photoreceptor function explain photopic and scotopic vision, central and peripheral vision, and the blind spot.",
   "achieves": "It lets the learner understand the visual capabilities and limitations that XR displays and immersive experiences must account for.",
   "segments": [
    "27/S4",
    "27/S5",
    "27/S6"
   ]
  }
 ],
