 "goal": {
  "id": "37/G",
  "goal": "Use contextual inquiry to gather usability requirements and specify them as design guidelines or functional requirements, while applying this process to the Majuli VR Tour to identify user groups and usability challenges.",
  "achieves": "This equips the learner to translate observed user needs into structured requirements for an XR system and to use a practical case study to inform later design and development choices."
 },
 "objectives": [
  {
   "id": "37/O1",
   "goal": "Describe how contextual inquiry observations can be transformed into design guidelines or functional requirements and specified in an SRS requirement hierarchy.",
   "achieves": "This gives the learner a way to convert observed user needs into structured requirement artifacts that can guide the design and implementation of an XR system.",
   "segments": [
    "37/S0",
    "37/S1",
    "37/S2"
   ]
  },
  {
   "id": "37/O2",
   "goal": "Apply contextual inquiry to the Majuli VR Tour to identify its user groups and the usability challenges associated with their contexts of use.",
   "achieves": "This helps the learner ground XR requirement gathering in the course case study and see how user-specific challenges inform later system design decisions.",
