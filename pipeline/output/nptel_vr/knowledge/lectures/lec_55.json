 "goal": {
  "id": "55/G",
  "goal": "Explain how a VR system renders three-dimensional objects into frame-buffer pixels by following the graphics pipeline and using object-representation techniques.",
  "achieves": "Provides the foundation for analyzing and optimizing the computational and display resources needed for VR rendering."
 },
 "objectives": [
  {
   "id": "55/O1",
   "goal": "Describe how the three-dimensional graphics pipeline computes frame-buffer values by transforming objects through coordinate systems and rendering stages.",
   "achieves": "Gives the learner a clear model of the VR rendering process, supporting later analysis of where computational work occurs in resource optimization.",
   "segments": [
    "55/S0",
    "55/S1"
   ]
  },
  {
   "id": "55/O2",
   "goal": "Explain how three-dimensional objects can be represented for rendering using point-sample, boundary/mesh, spline, space-partitioning, and other specialized techniques, and the trade-offs among those choices.",
   "achieves": "Lets the learner understand how object-representation choices shape rendering and resource requirements in VR systems.",
   "segments": [
    "55/S2",
    "55/S3",
    "55/S4",
    "55/S5"
   ]
  }
 ],
