 "goal": {
  "id": "55/G",
  "goal": "Explain how a three-dimensional graphics pipeline processes objects into pixels and classify the major three-dimensional object-representation categories, including their trade-offs.",
  "achieves": "Equips the learner with foundational graphics concepts needed to understand rendering workload and make informed VR resource-optimization decisions."
 },
 "objectives": [
  {
   "id": "55/O1",
   "goal": "Explain how the three-dimensional graphics pipeline stages and coordinate transformations convert objects into framebuffer pixel values.",
   "achieves": "Gives the learner a basis for identifying where rendering computation occurs in VR systems, supporting later analysis of VR resource optimization.",
   "segments": [
    "55/S0",
    "55/S1"
   ]
  },
  {
   "id": "55/O2",
   "goal": "Classify the major categories of three-dimensional object representation, including point-sample, boundary/mesh, parametric/spline, and space-partitioning methods, and explain their trade-offs and specialized uses.",
   "achieves": "Enables the learner to assess how object-representation choices affect realism, storage, and rendering work, which is needed for VR system design and resource optimization.",
   "segments": [
    "55/S2",
    "55/S3",
    "55/S4",
    "55/S5"
   ]
  }
 ],
