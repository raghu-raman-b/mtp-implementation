 "goal": {
  "id": "17/G",
  "goal": "Explain how IMU-based XR tracking obtains usable sensor data and maintains an orientation estimate by calibrating IMU readings, registering and integrating orientation, and correcting drift.",
  "achieves": "Provides foundational understanding of XR tracking technology that helps the learner understand headset tracking, assess tracking issues, and later build or optimize XR systems."
 },
 "objectives": [
  {
   "id": "17/O1",
   "goal": "Explain the preparation of IMU motion data for XR tracking, from raw gyroscope, accelerometer, and magnetometer readings to calibrated sensor values.",
   "achieves": "Gives the learner a sensor-level foundation for understanding how low-cost XR tracking devices obtain trustworthy motion input.",
   "segments": [
    "17/S0",
    "17/S1"
   ]
  },
  {
   "id": "17/O2",
   "goal": "Describe how an XR tracking system maintains orientation by registering an initial pose, integrating calibrated angular velocity, and applying drift correction.",
   "achieves": "Lets the learner understand how calibrated motion data become a maintained orientation estimate, supporting later work on XR system development and optimization.",
   "segments": [
    "17/S2",
    "17/S3"
   ]
  }
 ],
