 "goal": {
  "id": "17/G",
  "goal": "Explain the basic IMU-based tracking pipeline used in XR systems to estimate orientation from sensor data while reducing drift and measurement error.",
  "achieves": "It provides the conceptual grounding for XR tracking technologies that supports the course aim of understanding and implementing an XR system with confidence."
 },
 "objectives": [
  {
   "id": "17/O1",
   "goal": "Explain how an IMU-based tracking system estimates and updates orientation by calibrating sensor readings, registering an initial orientation, integrating calibrated angular velocity, and applying drift correction.",
   "achieves": "It gives the learner a foundational understanding of sensor-based tracking and orientation error correction, helping them understand XR hardware and the tracking issues addressed later in XR development and optimization.",
