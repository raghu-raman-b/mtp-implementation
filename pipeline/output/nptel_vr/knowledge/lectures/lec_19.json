 "goal": {
  "id": "19/G",
  "goal": "Explain the role, development pipeline, and motion-support requirements of VR software in creating a sensory virtual reality experience.",
  "achieves": "It provides the foundational understanding of the VR software layer needed to design, build, and optimize XR systems in the course case study."
 },
 "objectives": [
  {
   "id": "19/O1",
   "goal": "Explain how VR software drives VR hardware and mediates user data to produce a sensory virtual reality experience.",
   "achieves": "It lets the learner locate software functions between VR hardware and user perception before designing or implementing VR components in the course case study.",
   "segments": [
    "19/S0",
    "19/S1"
   ]
  },
  {
   "id": "19/O2",
   "goal": "Describe the software pipeline and developer-support abstractions that create and render a virtual environment for VR users.",
   "achieves": "It gives the learner a foundation for choosing and reasoning about the software components needed to build a VR application in the course case study.",
   "segments": [
    "19/S2",
    "19/S3"
   ]
  },
  {
   "id": "19/O3",
   "goal": "Describe the motion and locomotion support VR software must provide, including matched motion, the matched zone, obstacle mismatch, and alternative locomotion approaches.",
   "achieves": "It helps the learner anticipate cybersickness and usability constraints when designing VR interactions, which informs later user-experience optimization.",
   "segments": [
    "19/S4"
   ]
  }
 ],
