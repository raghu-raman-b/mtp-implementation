 "goal": {
  "id": "19/G",
  "goal": "Explain how VR software produces a usable virtual reality experience by driving hardware, managing the user-system data flow, creating and rendering a virtual world, and supporting user locomotion.",
  "achieves": "provides the foundational software knowledge needed to understand and implement an XR system, including its hardware interactions, development components, and human-factor constraints."
 },
 "objectives": [
  {
   "id": "19/O1",
   "goal": "Describe the role of VR software in the data flow between the user and VR hardware that generates a sensory virtual reality experience, including where processing, interaction design, and perceptual design occur.",
   "achieves": "helps the learner locate VR software within a VR system and understand where tracking, stimulation, interaction design, and perceptual design take place, supporting later hardware-software integration in XR development.",
   "segments": [
    "19/S0",
    "19/S1"
   ]
  },
  {
   "id": "19/O2",
   "goal": "Describe the software support needed to create and render a virtual world, including environment modeling, rendering, developer support, and a virtual-world-generator abstraction.",
   "achieves": "gives the learner a functional model of VR software components and graphics support, preparing them to choose tools and implement the course's VR case study.",
   "segments": [
    "19/S2",
    "19/S3"
   ]
  },
  {
   "id": "19/O3",
   "goal": "Explain how VR software supports user locomotion by maintaining matched motion and the matched zone while providing alternatives such as teleportation or vehicle metaphors.",
   "achieves": "helps the learner relate software motion design to user comfort and cybersickness, which supports human-factor evaluation and later user-experience optimization.",
   "segments": [
    "19/S4"
   ]
  }
 ],
