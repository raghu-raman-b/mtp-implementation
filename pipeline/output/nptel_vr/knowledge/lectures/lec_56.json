 "goal": {
  "id": "56/G",
  "goal": "Explain the computer-graphics foundations of VR rendering and resource optimization by describing the 3D graphics pipeline, geometric transformations, and the lighting-to-intensity mapping process.",
  "achieves": "It provides the foundational understanding of rendering required to identify where computational and display resources are used and to address resource-optimization issues later in the course."
 },
 "objectives": [
  {
   "id": "56/O1",
   "goal": "Explain how the 3D graphics pipeline supports VR rendering, including its five stages and how modeling and composite transformations convert local-coordinate objects into world-space vertices.",
   "achieves": "It gives the learner a foundation for recognizing the geometric stages of rendering that contribute to VR resource requirements and for making informed choices when implementing scene transformations.",
   "segments": [
    "56/S0",
    "56/S1",
    "56/S2",
    "56/S3",
    "56/S4"
   ]
  },
  {
   "id": "56/O2",
   "goal": "Describe how lighting models compute ambient, diffuse, and specular intensities, extend those computations with attenuation, colored and multiple light sources, and map continuous intensities to finite device pixel values.",
   "achieves": "It lets the learner understand the computational and display-related aspects of image formation that must be considered when analyzing and optimizing VR rendering resources.",
   "segments": [
    "56/S5",
    "56/S6",
    "56/S7",
    "56/S8",
    "56/S9",
    "56/S10"
   ]
  }
 ],
