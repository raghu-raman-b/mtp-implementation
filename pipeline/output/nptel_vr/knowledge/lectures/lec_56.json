 "goal": {
  "id": "56/G",
  "goal": "Explain how a VR scene is rendered through the 3D graphics pipeline, from modeling transformations through lighting and color computation to pixel intensity mapping, in order to understand where rendering consumes computational and display resources.",
  "achieves": "Gives foundational knowledge of VR rendering stages and their resource-relevant computations, preparing the learner to analyze and optimize an XR system."
 },
 "objectives": [
  {
   "id": "56/O1",
   "goal": "Explain how computer graphics and the 3D graphics pipeline establish the context for VR rendering, including the five pipeline stages and the stages covered in the lecture.",
   "achieves": "Gives the learner a structural map of VR rendering that lets them later target resource-consuming stages for optimization.",
   "segments": [
    "56/S0",
    "56/S1"
   ]
  },
  {
   "id": "56/O2",
   "goal": "Describe how modeling transformations place local-coordinate objects in a world scene and how those transformations are represented and applied using homogeneous-coordinate matrices.",
   "achieves": "Lets the learner understand and implement geometric scene setup, a foundational part of building and optimizing an XR system.",
   "segments": [
    "56/S2",
    "56/S3",
    "56/S4"
   ]
  },
  {
   "id": "56/O3",
   "goal": "Explain how color computation in the graphics pipeline produces displayable pixel values by using lighting models to compute continuous intensities and mapping those intensities to device-supported values and bit patterns.",
   "achieves": "Enables the learner to assess the computational and memory demands of lighting, intensity calculation, and display mapping in VR rendering.",
   "segments": [
