 "goal": {
  "id": "59/G",
  "goal": "Explain the resource optimization logic of the Majuli VR case study, from the demands of multimodal real-time rendering to platform-specific choices for Oculus Quest 2 and smartphone/cardboard deployment.",
  "achieves": "It gives the learner a concrete foundation for the course's system optimization and resource-requirements topics by linking hardware constraints, rendering demands, and deployment decisions in a practical VR system."
 },
 "objectives": [
  {
   "id": "59/O1",
   "goal": "Explain the resource optimization logic of the Majuli VR case study, showing why its multimodal content demands optimization and how its Oculus Quest 2 and smartphone/cardboard deployments balance local resources, network use, and content fidelity.",
   "achieves": "It lets the learner evaluate storage, computation, network, and content-quality trade-offs when deploying VR applications on constrained or standalone devices, supporting the course aim of implementing XR systems with confidence.",
