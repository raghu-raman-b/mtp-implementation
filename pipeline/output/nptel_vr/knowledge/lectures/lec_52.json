 "goal": {
  "id": "52/G",
  "goal": "Describe how to formulate a time-constrained virtual-reality tour optimization problem and solve it by casting it as a vehicle routing problem with profit and using a VRPP-based graph transformation algorithm.",
  "achieves": "It provides the learner with a concrete optimization method for improving VR tour experience and exposure time, preparing them to address optimization issues in the course's XR case study."
 },
 "objectives": [
  {
   "id": "52/O1",
   "goal": "Formulate a time-constrained virtual-reality tour optimization problem that maximizes total point-of-interest importance while respecting a cybersickness time threshold and total path completion time including waiting times.",
   "achieves": "It gives the learner the formal optimization model needed to understand and evaluate routing-based methods for VR tour design in the course's XR case study.",
   "segments": [
    "52/S0",
    "52/S1",
    "52/S2"
   ]
  },
  {
   "id": "52/O2",
   "goal": "Explain how the formulated tour optimization problem can be solved by modeling it as a vehicle routing problem with profit and using a graph-transformation algorithm with a VRPP solver to obtain the optimal tour path.",
   "achieves": "It lets the learner connect the optimization model to a concrete operations-research solution technique, supporting the course aim of optimizing an XR system with confidence.",
   "segments": [
    "52/S3",
    "52/S4"
   ]
  }
 ],
