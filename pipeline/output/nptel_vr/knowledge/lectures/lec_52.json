 "goal": {
  "id": "52/G",
  "goal": "Formulate and solve a time-constrained VR tour optimization problem that maximizes point-of-interest importance within a cybersickness time threshold by using a vehicle routing with profit model and solver.",
  "achieves": "It prepares the learner to apply an optimization technique in the course's system development stage, supporting the aim of building XR systems with confidence and appropriate cybersickness controls."
 },
 "objectives": [
  {
   "id": "52/O1",
   "goal": "Formulate a time-constrained VR tour optimization model that maximizes point-of-interest importance while respecting a cybersickness exposure time threshold and node waiting times.",
   "achieves": "It lets the learner express the navigation-path optimization part of an XR system as a defined problem that balances experience value against cybersickness limits.",
   "segments": [
    "52/S0",
    "52/S1",
    "52/S2"
   ]
  },
  {
   "id": "52/O2",
   "goal": "Describe how to solve the formulated VR tour optimization problem by recasting it as a vehicle routing problem with profit and using a graph transformation with a VRPP solver to obtain the optimal path.",
   "achieves": "It lets the learner apply an established optimization method to generate a value-maximizing and cybersickness-aware VR tour path for an XR system.",
   "segments": [
    "52/S3",
    "52/S4"
   ]
  }
 ],
