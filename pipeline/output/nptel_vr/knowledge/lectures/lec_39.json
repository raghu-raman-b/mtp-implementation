 "goal": {
  "id": "39/G",
  "goal": "Explain how object interaction in immersive experience design is organized into selection and manipulation, and describe the main techniques and criteria for choosing them.",
  "achieves": "Prepares the learner to specify and evaluate object-interaction features in the system-design stage of building an XR system."
 },
 "objectives": [
  {
   "id": "39/O1",
   "goal": "Explain the broad categories of interaction in immersive experience design.",
   "achieves": "Gives the learner a framework for distinguishing object interaction, navigation, and system control when specifying the interaction requirements of an XR experience.",
   "segments": [
    "39/S0"
   ]
  },
  {
   "id": "39/O2",
   "goal": "Describe object selection techniques and the parameters used to choose among them.",
   "achieves": "Lets the learner evaluate and select suitable hand-based, pointing-based, image-plane, and volumetric techniques for selecting virtual objects in an XR system.",
   "segments": [
    "39/S1",
    "39/S2",
    "39/S3",
    "39/S4"
   ]
  },
  {
   "id": "39/O3",
   "goal": "Describe object manipulation techniques, including hand-based, indirect, bimanual, and integrated hybrid approaches.",
   "achieves": "Lets the learner assess methods for changing a virtual object's position, orientation, scale, shape, or behavior when designing XR interaction.",
   "segments": [
    "39/S5",
    "39/S6",
    "39/S7",
    "39/S8"
   ]
  }
 ],
