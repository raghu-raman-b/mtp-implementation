 "goal": {
  "id": "39/G",
  "goal": "Explain the organization of object interaction in immersive XR experience design, from the main interaction categories and selection criteria to the major selection and manipulation techniques.",
  "achieves": "It prepares the learner to specify object interaction in the XR system case study by understanding the available techniques and the criteria for choosing selection techniques."
 },
 "objectives": [
  {
   "id": "39/O1",
   "goal": "Establish the framework for object interaction in immersive experience design by identifying the main interaction categories and the criteria for choosing object selection techniques.",
   "achieves": "It gives the learner a vocabulary and decision basis for specifying object interaction requirements in the XR system case study.",
   "segments": [
    "39/S0",
    "39/S1"
   ]
  },
  {
   "id": "39/O2",
   "goal": "Explain the major object selection techniques in immersive environments, including hand-based, pointing-based, image-plane, and volumetric selection.",
   "achieves": "It lets the learner compare selection techniques and match one to the target objects, viewpoint, distance, and task in the XR system.",
   "segments": [
    "39/S2",
    "39/S3",
    "39/S4"
   ]
  },
  {
   "id": "39/O3",
   "goal": "Describe the main object manipulation techniques in immersive environments, including hand-based, indirect, bimanual, and integrated hybrid manipulation.",
   "achieves": "It lets the learner identify manipulation approaches that fit the object properties and interaction requirements of the XR system.",
   "segments": [
    "39/S5",
    "39/S6",
    "39/S7",
    "39/S8"
   ]
  }
 ],
