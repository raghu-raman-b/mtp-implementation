 "goal": {
  "id": "46/G",
  "goal": "Explain how to design and statistically evaluate an empirical user study for an XR system implementation, from representative participants and tasks to appropriate significance testing.",
  "achieves": "It provides the evaluation foundation for completing the case-study implementation stage, enabling the learner to interpret experimental evidence about an XR system with confidence."
 },
 "objectives": [
  {
   "id": "46/O1",
   "goal": "Explain how to design an empirical user experiment for an XR system implementation, including representative participants, representative tasks, sample size, and an assignment structure that limits practice effects.",
   "achieves": "It supports the course's practical case study by giving the learner the basis for setting up a valid empirical evaluation of an implemented XR system.",
   "segments": [
    "46/S0",
    "46/S1",
    "46/S2"
   ]
  },
  {
   "id": "46/O2",
   "goal": "Explain how to evaluate empirical XR experiment data by determining whether differences are statistically significant and selecting an appropriate parametric or non-parametric test.",
   "achieves": "It supports the course aim of implementing an XR system with confidence by enabling the learner to interpret experimental results defensibly.",
   "segments": [
    "46/S3",
    "46/S4"
   ]
  }
 ],
