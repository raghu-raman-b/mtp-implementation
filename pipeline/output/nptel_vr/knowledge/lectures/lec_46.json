 "goal": {
  "id": "46/G",
  "goal": "Explain how to design and analyze an empirical user study for evaluating an XR system.",
  "achieves": "This supports the course aim of implementing an XR system with confidence by giving the learner a method for evidence-based evaluation of the system."
 },
 "objectives": [
  {
   "id": "46/O1",
   "goal": "Explain how to design a controlled empirical user study for an XR system.",
   "achieves": "This gives the learner the basis for collecting representative, well-controlled user evidence during implementation of an XR system.",
   "segments": [
    "46/S0",
    "46/S1",
    "46/S2"
   ]
  },
  {
   "id": "46/O2",
   "goal": "Explain how to analyze empirical user-study data by selecting an appropriate statistical test and determining whether observed differences are statistically significant.",
   "achieves": "This lets the learner judge whether observed XR interface differences are meaningful, supporting data-backed implementation decisions and later optimization.",
   "segments": [
    "46/S3",
    "46/S4"
   ]
  }
 ],
