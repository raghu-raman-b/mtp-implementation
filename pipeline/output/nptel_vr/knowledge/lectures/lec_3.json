 "goal": {
  "id": "3/G",
  "goal": "Describe the application potential of XR and the technological categories of augmented reality, linking main AR application domains with marker-based and markerless AR system types.",
  "achieves": "Provides a foundational map of where and how AR is applied, enabling the learner to understand and evaluate later XR system development choices with confidence."
 },
 "objectives": [
  {
   "id": "3/O1",
   "goal": "Describe the application potential of XR and the main augmented reality application domains, using consumer/customer-experience and healthcare examples that augment real-world content.",
   "achieves": "Gives the learner a concrete understanding of where AR is used and what user problems it addresses, preparing them to connect later XR hardware, software, and development concepts to real application needs.",
   "segments": [
    "3/S0",
    "3/S1"
   ]
  },
  {
   "id": "3/O2",
   "goal": "Classify augmented reality systems into marker-based and markerless categories and explain the location-based, superimposition-based, projection-based, and outlining-based markerless subtypes.",
   "achieves": "Equips the learner to identify the technical basis of an AR system and to relate later tracking, sensor, computer-vision, and display topics to appropriate AR application types.",
   "segments": [
    "3/S2"
   ]
  }
