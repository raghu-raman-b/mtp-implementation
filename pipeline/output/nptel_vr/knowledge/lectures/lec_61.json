 "goal": {
  "id": "61/G",
  "goal": "Explain how Unity's graphics, physics, animation, and audio systems support the practical construction of an XR application.",
  "achieves": "Gives the learner a concrete Unity-based foundation for understanding and implementing an XR system, serving the course's aim of building XR applications with confidence."
 },
