 "goal": {
  "id": "61/G",
  "goal": "Explain how Unity implements the rendering, physics, animation, and audio subsystems used to build an XR application.",
  "achieves": "It gives the learner foundational engine-level knowledge to connect XR concepts to practical implementation and build an XR system with confidence."
 },
 "objectives": [
  {
   "id": "61/O1",
   "goal": "Describe how Unity's graphics-pipeline environment supports creating and displaying visual content for XR applications.",
   "achieves": "It lets the learner choose and use Unity's render pipelines and graphics APIs to build the visual foundation of an XR system.",
   "segments": [
    "61/S0",
    "61/S1",
    "61/S2",
    "61/S3"
   ]
  },
  {
   "id": "61/O2",
   "goal": "Explain how Unity's physics engine uses rigid bodies, colliders, joints, and articulation to simulate realistic motion and collision in XR scenes.",
   "achieves": "It lets the learner add credible physical interaction to XR content when implementing an XR system.",
   "segments": [
    "61/S4"
   ]
  },
  {
   "id": "61/O3",
   "goal": "Explain how Unity's animation and audio components support character animation and immersive sound in XR experiences.",
   "achieves": "It lets the learner build the motion and sensory aspects of an immersive XR experience as part of a practical XR implementation.",
   "segments": [
    "61/S5"
   ]
  }
 ],
