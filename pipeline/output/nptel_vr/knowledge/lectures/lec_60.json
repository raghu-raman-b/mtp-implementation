 "goal": {
  "id": "60/G",
  "goal": "Describe how to use Unity to move from XR theory to practice by setting up the implementation environment and constructing a previewable XR scene from its core editor components.",
  "achieves": "Gives learners a practical foundation for implementing and previewing XR systems, supporting the course aim of understanding and building an XR system with confidence."
 },
 "objectives": [
  {
   "id": "60/O1",
   "goal": "Explain the Unity implementation toolchain, including Unity's role as a cross-platform XR development environment and how Unity Hub installs and manages the Unity editor and game engine.",
   "achieves": "Gives learners the ability to set up and identify the software environment needed to begin practical XR system development.",
   "segments": [
    "60/S1",
    "60/S2"
   ]
  },
  {
   "id": "60/O2",
   "goal": "Describe how Unity's editor supports creating and previewing an XR scene, including its XR settings, scene and game views, and core scene elements such as assets, scenes, game objects, and prefabs.",
   "achieves": "Gives learners the scene-level workflow needed to start translating XR concepts into a buildable XR system for the course case study.",
