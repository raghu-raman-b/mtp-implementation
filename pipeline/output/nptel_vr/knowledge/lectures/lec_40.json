 "goal": {
  "id": "40/G",
  "goal": "Explain the navigation and system-control design space for XR systems, covering locomotion techniques, wayfinding supports, and multimodal interaction options.",
  "achieves": "This lets the learner design or evaluate the movement, orientation, and control features of the course's XR case study."
 },
 "objectives": [
  {
   "id": "40/O1",
   "goal": "Describe how navigation in an immersive experience is organized into travel and wayfinding, with the travel side expressed through distinct locomotion technique families.",
   "achieves": "This gives the learner a basis for choosing movement methods when designing the navigation part of an XR system.",
   "segments": [
    "40/S0",
    "40/S1",
    "40/S2",
    "40/S3",
    "40/S4"
   ]
  },
  {
   "id": "40/O2",
   "goal": "Describe how wayfinding supports help users form spatial knowledge and mental maps for moving toward destinations in a virtual environment.",
   "achieves": "This lets the learner specify orientation and destination-finding aids when designing an immersive environment.",
   "segments": [
    "40/S5"
   ]
  },
  {
   "id": "40/O3",
   "goal": "Describe interaction techniques for controlling system state and modes in an XR system, including multimodal command methods.",
   "achieves": "This lets the learner define controls and commands for the XR application as part of system design.",
   "segments": [
    "40/S6"
   ]
  }
 ],
