 "goal": {
  "id": "40/G",
  "goal": "Describe how navigation and system-control interaction are designed in an immersive XR experience.",
  "achieves": "It supports the course aim of building an XR system with confidence by giving the learner a design-level understanding of core movement and control functions."
 },
 "objectives": [
  {
   "id": "40/O1",
   "goal": "Explain how navigation in an immersive XR experience is composed of travel and wayfinding, including the main locomotion techniques and wayfinding supports that enable it.",
