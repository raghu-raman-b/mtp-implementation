 "goal": {
  "id": "29/G",
  "goal": "Explain how auditory perception supports immersive XR experiences by connecting the role of audio to the physical nature of sound and the human hearing system.",
  "achieves": "Equips the learner with foundational knowledge of the auditory sense needed to understand and evaluate immersive XR experiences as part of the course's human-factors and system-development goals."
 },
 "objectives": [
  {
   "id": "29/O1",
   "goal": "Explain why auditory sense enhances immersive XR experiences by complementing visual perception to support believability and presence.",
   "achieves": "Establishes the human-factors rationale for including audio in XR systems, helping the learner understand why auditory features matter when designing immersive experiences.",
   "segments": [
    "29/S0"
   ]
  },
  {
   "id": "29/O2",
   "goal": "Trace how sound is characterized as a pressure wave and converted by the human ear into neural impulses.",
   "achieves": "Provides the physical and perceptual foundation for understanding how audio is received and experienced in immersive XR systems.",
