 "goal": {
  "id": "29/G",
  "goal": "Explain how audio contributes to immersive XR experiences by connecting sound's physical properties and human hearing to believability and presence.",
  "achieves": "Equips the learner with foundational human-factors knowledge for understanding and later addressing the auditory dimension in XR system design and implementation."
 },
 "objectives": [
  {
   "id": "29/O1",
   "goal": "Explain how audio supports believable and present XR experiences by complementing visual information.",
   "achieves": "Gives the learner a basis for recognizing audio as a key human factor when evaluating or designing immersive XR systems.",
   "segments": [
    "29/S0"
   ]
  },
  {
   "id": "29/O2",
   "goal": "Trace how sound waves are physically characterized and converted by the human auditory system into neural impulses.",
   "achieves": "Provides the physical and perceptual foundations needed to understand why and how audio shapes immersion in XR.",
