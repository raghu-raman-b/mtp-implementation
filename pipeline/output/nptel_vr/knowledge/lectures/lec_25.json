 "goal": {
  "id": "25/G",
  "goal": "Describe how human perception and sensory physiology shape the design of XR systems.",
  "achieves": "Provides foundational human-factors knowledge that supports the course aim of understanding and implementing an XR system with confidence."
 },
 "objectives": [
  {
   "id": "25/O1",
   "goal": "Explain why creating presence in XR requires understanding human perception and how perceptual psychology frames the related design questions, including risks such as cybersickness.",
   "achieves": "Gives the learner a conceptual basis for recognizing human perceptual constraints and selecting relevant human-factors considerations in later XR design work.",
   "segments": [
    "25/S0",
    "25/S1",
    "25/S2"
   ]
  },
  {
   "id": "25/O2",
   "goal": "Describe how the human senses are organized by stimulus, receptor, and sense organ and why each sensory system responds selectively to specific stimuli.",
   "achieves": "Gives the learner the sensory-physiological vocabulary needed to understand later XR topics on visual, auditory, and other senses.",
   "segments": [
    "25/S3",
    "25/S4"
   ]
  }
 ],
