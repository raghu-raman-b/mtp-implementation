 "goal": {
  "id": "49/G",
  "goal": "Explain how immersive VR optimization separates experience and resource concerns and why cybersickness, presence, locomotion, and walking-speed matching guide experience optimization in system-controlled virtual reality tours.",
  "achieves": "It gives the learner a foundation for making cybersickness- and presence-aware experience optimization decisions in XR systems, supporting the course aim of understanding and implementing an XR system with confidence."
 },
 "objectives": [
  {
   "id": "49/O1",
   "goal": "Characterize immersive VR experience optimization by distinguishing it from resource optimization and by identifying cybersickness, its causes, and the requirement to preserve presence.",
   "achieves": "It lets the learner recognize why experience optimization is distinct from resource optimization and why cybersickness mitigation must not degrade presence.",
   "segments": [
    "49/S0",
    "49/S1"
   ]
  },
  {
   "id": "49/O2",
   "goal": "Describe how VR locomotion techniques, navigation duration or distance, and optic-flow walking-speed matching motivate a walking-speed model for system-controlled virtual reality tours.",
   "achieves": "It gives the learner a basis for evaluating locomotion and walking-speed choices that reduce cybersickness in system-controlled tours while maintaining presence.",
   "segments": [
    "49/S2",
    "49/S3"
   ]
  }
 ],
