 "goal": {
  "id": "13/G",
  "goal": "Explain how VR hardware participates in a VR system that includes the user/organism and physical environment, and identify the main hardware categories and input devices that support user interaction.",
  "achieves": "Provides the foundational VR hardware knowledge needed for the course's aim of understanding and implementing XR systems with confidence."
 },
 "objectives": [
  {
   "id": "13/O1",
   "goal": "Explain the systems-level view of a VR system, in which the user/organism, physical environment, and VR hardware are connected by stimulation and tracking data flows that capture user actions.",
   "achieves": "Gives the learner a foundational model of how VR systems interact with people and surroundings, which supports later study of tracking, input, and XR system development.",
   "segments": [
    "13/S0",
    "13/S1",
    "13/S2"
   ]
  },
  {
   "id": "13/O2",
   "goal": "Characterize the main categories of VR hardware and the hand-based and non-hand-based input devices used to capture user actions, including their capabilities, limitations, and multimodal implications.",
   "achieves": "Enables the learner to identify and discuss VR hardware components and input options when understanding or contributing to the development of an XR system.",
   "segments": [
    "13/S3",
    "13/S4",
    "13/S5"
   ]
  }
 ],
