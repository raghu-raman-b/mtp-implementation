 "goal": {
  "id": "13/G",
  "goal": "Describe the complete view of a virtual reality system and classify its main hardware categories and input-device types.",
  "achieves": "Provides the foundational hardware and system model needed to follow later XR hardware/software, human-factors, development, and optimization topics and to implement an XR system with confidence."
 },
 "objectives": [
  {
   "id": "13/O1",
   "goal": "Describe the complete view of a virtual reality system as comprising the user/organism, VR hardware, and surrounding physical environment, and explain how stimulation and tracking data flows connect them.",
   "achieves": "Equips the learner with a system-level understanding of VR interaction that supports later study of VR/AR hardware, software, human factors, and system design.",
   "segments": [
    "13/S0",
    "13/S1",
    "13/S2"
   ]
  },
  {
   "id": "13/O2",
   "goal": "Identify the three main functional categories of VR hardware and describe the major hand-based and non-hand-based input devices, their examples, trade-offs, and the reason multimodal input is preferred.",
   "achieves": "Supports the learner in recognizing appropriate VR hardware options and input modalities when understanding requirements, designing, or implementing an XR system.",
   "segments": [
    "13/S3",
    "13/S4",
    "13/S5"
   ]
  }
 ],
