 "goal": {
  "id": "31/G",
  "goal": "Explain how somatosensory, haptic, olfactory, and gustatory senses can be perceived and simulated to extend XR immersion beyond visual and auditory channels.",
  "achieves": "It provides foundational human-factors knowledge for understanding and implementing XR systems that aim to support a more complete sensory experience."
 },
 "objectives": [
  {
   "id": "31/O1",
   "goal": "Explain how human somatosensory and haptic perception can be supported by XR haptic devices and tangible interfaces to create touch-like immersion.",
   "achieves": "It gives the learner a physiological and technical basis for understanding and evaluating touch and body-sense feedback in XR systems.",
   "segments": [
    "31/S0",
    "31/S1",
    "31/S2"
   ]
  },
  {
   "id": "31/O2",
   "goal": "Describe how smell and taste can be simulated in XR and why these chemical-sense interfaces are technically challenging and less developed.",
   "achieves": "It helps the learner consider the major remaining senses and their practical limits when understanding or designing for fuller XR immersion.",
   "segments": [
    "31/S3"
   ]
  }
 ],
