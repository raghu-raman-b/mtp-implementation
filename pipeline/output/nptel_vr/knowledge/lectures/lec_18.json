 "goal": {
  "id": "18/G",
  "goal": "Explain the main tracking technologies used in VR and AR, how they estimate position and orientation, and how hybrid systems combine them.",
  "achieves": "It provides the foundational understanding of tracking needed to evaluate XR hardware and software choices and to design and implement an XR system confidently."
 },
 "objectives": [
  {
   "id": "18/O1",
   "goal": "Explain the main categories of XR tracking and how electromechanical, electromagnetic, and acoustic/ultrasonic trackers estimate position and orientation.",
   "achieves": "It gives the learner a first framework for distinguishing tracking hardware and software options in later XR system discussions.",
   "segments": [
    "18/S0",
    "18/S1",
    "18/S2"
   ]
  },
  {
   "id": "18/O2",
   "goal": "Explain how vision-based and structure-based tracking methods use optical or depth sensing to estimate pose.",
   "achieves": "It lets the learner understand camera- and depth-based tracking choices and their implications for accuracy, performance, and XR system design.",
   "segments": [
    "18/S3",
    "18/S4",
    "18/S5",
    "18/S6",
    "18/S7"
   ]
  },
  {
   "id": "18/O3",
   "goal": "Describe how sensor-based and hybrid tracking methods use inertial, positional, motion-capture, and eye-tracking data, including their limitations.",
   "achieves": "It enables the learner to recognize how XR interaction can track the whole body, gaze, or a combination of signals, and to identify limitations when selecting tracking approaches.",
   "segments": [
    "18/S8",
    "18/S9"
   ]
  }
 ],
