 "goal": {
  "id": "18/G",
  "goal": "Classify and explain the main tracking technologies used to determine user and device pose in VR and AR.",
  "achieves": "It gives the learner the hardware/software foundation needed to evaluate tracking choices and later implement an XR system with confidence."
 },
 "objectives": [
  {
   "id": "18/O1",
   "goal": "Classify the main XR tracking technologies and explain how electromechanical, electromagnetic, and acoustic/ultrasonic trackers measure pose.",
   "achieves": "It gives the learner a baseline for comparing sensor-based pose measurement options in VR and AR hardware.",
   "segments": [
    "18/S0",
    "18/S1",
    "18/S2"
   ]
  },
  {
   "id": "18/O2",
   "goal": "Explain how vision-based XR tracking systems estimate pose from camera and depth sensor observations.",
   "achieves": "It lets the learner compare inside-out and outside-in visual and depth approaches when selecting tracking for an XR application.",
   "segments": [
    "18/S3",
    "18/S4",
    "18/S5",
    "18/S6",
    "18/S7"
   ]
  },
  {
   "id": "18/O3",
   "goal": "Explain how inertial tracking and GPS/RTK provide positional tracking in XR and where their limitations occur.",
   "achieves": "It helps the learner understand self-contained and satellite-based position sources that complement camera-based tracking in system design.",
   "segments": [
    "18/S8"
   ]
  },
  {
   "id": "18/O4",
   "goal": "Describe how XR tracking can be extended to full-body motion, gaze, and hybrid multi-sensor systems.",
   "achieves": "It enables the learner to recognize how these methods support richer interaction and immersion in XR implementations.",
   "segments": [
    "18/S9"
   ]
  }
 ],
