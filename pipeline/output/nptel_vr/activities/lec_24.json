{
 "lecture": "24",
 "activities": [
  {
   "id": "24/A0",
   "kind": "recall",
   "scope": "lecture",
   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C0725",
      "prompt": "What is middleware?",
      "answer": "Ideally, virtual reality (VR) software should let a developer provide only high-level descriptions from which all low-level details are automatically determined; the developer can then use middleware between the developer and the hardware, following well-known patterns and calling well-designed software libraries to avoid micro-level activities; and the software should also allow the developer to design functions from scratch for original work rather than depending on middleware.",
      "from_lecture": "19"
     },
     {
      "concept": "C0323",
      "prompt": "What is human factors?",
      "answer": "Human factors in system design requires designers to know the users' characteristics and design the system accordingly, because users who perform the same broad task, such as a traveler or agent and a database administrator obtaining railway ticket information, can have different expectations, needs, and query-language skills, and therefore require different interfaces for providing input, seeing the outcome, and acting on the outcome.",
      "from_lecture": "23"
     },
     {
      "concept": "C1333",
      "prompt": "What is user-centric approach?",
      "answer": "The user-centric approach, generally recommended for building interactive systems, is the process of designing computer systems in which users' needs and expectations are taken care of by considering user characteristics, and it starts by understanding user characteristics, what users need and expect, and then designing the system based on that.",
      "from_lecture": "23"
     },
     {
      "concept": "C0003",
      "prompt": "What is augmented reality (AR)?",
      "answer": "Augmented reality on the reality-virtuality continuum is the intermediate state in which the real environment is augmented with virtual content.",
      "from_lecture": "1"
     },
     {
      "concept": "C0002",
      "prompt": "What is virtual reality (VR)?",
      "answer": "Virtual reality (VR) is, according to the Miriam Webster dictionary, an artificial environment experienced through sensory stimuli, in which sights and sounds play a primary role and are provided by a computer, possibly along with other sensory stimuli, and in which a person's actions partially determine what happens in the environment.",
      "from_lecture": "4"
     },
     {
      "concept": "C0174",
      "prompt": "What is sensor?",
      "answer": "Virtual reality (VR) hardware has three major components: displays (output devices), sensors (input devices), and computers (processing devices).",
      "from_lecture": "13"
     }
    ]
   },
