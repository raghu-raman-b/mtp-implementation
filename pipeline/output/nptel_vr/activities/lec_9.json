 "activities": [
  {
   "id": "9/A0",
   "kind": "recall",
   "scope": "lecture",
   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C0042",
      "prompt": "What is immersion?",
      "answer": "Immersion in virtual reality (VR) means that the user's senses are blocked so that the user receives no input from the real-world environment and receives input only from the virtual world.",
      "from_lecture": "2"
     },
     {
      "concept": "C0002",
      "prompt": "What is virtual reality (VR)?",
      "answer": "Virtual reality (VR) is, according to the Miriam Webster dictionary, an artificial environment experienced through sensory stimuli, in which sights and sounds play a primary role and are provided by a computer, possibly along with other sensory stimuli, and in which a person's actions partially determine what happens in the environment.",
      "from_lecture": "4"
     },
     {
      "concept": "C0279",
      "prompt": "What is three-dimensional registration?",
      "answer": "In 1997, computer-vision techniques were used to overlay augmented reality (AR) content on real-world markers, and tracking was used to register the AR content in three dimensions.",
      "from_lecture": "7"
     },
     {
      "concept": "C0324",
      "prompt": "What is presence?",
      "answer": "Presence is the psychological side that captures whether a user perceives the immersive qualities that are generated.",
      "from_lecture": "8"
     },
     {
      "concept": "C0003",
      "prompt": "What is augmented reality (AR)?",
      "answer": "Augmented reality on the reality-virtuality continuum is the intermediate state in which the real environment is augmented with virtual content.",
      "from_lecture": "1"
     },
     {
      "concept": "C0009",
      "prompt": "What is immersive experience?",
      "answer": "An immersive experience is a perceived experience through sensory organs that appears real: when a person experiences an environment through sensory organs and fails to distinguish that environment from the person's real environment, perceiving it as the real environment, the technology producing that experience is an immersive technology.",
      "from_lecture": "1"
     }
    ]
   },
