   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C0324",
      "prompt": "What is presence?",
      "answer": "Presence is the psychological side that captures whether a user perceives the immersive qualities that are generated.",
      "from_lecture": "8"
     },
     {
      "concept": "C1521",
      "prompt": "What is frequency?",
      "answer": "Sound waves are primarily characterized by three properties relevant for dealing with sound waves: frequency, amplitude, and phase, because sound can be represented as a wave.",
      "from_lecture": "29"
     },
     {
      "concept": "C1607",
      "prompt": "What is sound wave?",
      "answer": "Sound can be represented as a sound wave, which is a plot of pressure variation against time with time on the x-axis and air pressure on the y-axis, and the pressure varies from one extreme to another like a sinusoidal wave as time progresses.",
      "from_lecture": "29"
     },
     {
      "concept": "C0002",
      "prompt": "What is virtual reality (VR)?",
      "answer": "Virtual reality (VR) is, according to the Miriam Webster dictionary, an artificial environment experienced through sensory stimuli, in which sights and sounds play a primary role and are provided by a computer, possibly along with other sensory stimuli, and in which a person's actions partially determine what happens in the environment.",
      "from_lecture": "4"
     },
     {
      "concept": "C0358",
      "prompt": "What is cybersickness (CS)?",
      "answer": "Cybersickness (CS), also known in the literature as visually induced motion sickness (VIMS), is a condition that can affect individuals when they interact with virtual reality (VR) technology and is primarily relevant to virtual reality.",
      "from_lecture": "10"
     },
     {
      "concept": "C0001",
      "prompt": "What is extended reality (XR)?",
      "answer": "Extended Reality (XR) is an umbrella term, not a specific technology, that covers all present or future immersive technologies, such as augmented reality (AR), virtual reality (VR), and mixed reality (MR).",
      "from_lecture": "1"
     }
    ]
   },
