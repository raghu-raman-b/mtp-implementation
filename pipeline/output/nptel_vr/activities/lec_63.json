   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C0003",
      "prompt": "What is augmented reality (AR)?",
      "answer": "Augmented reality on the reality-virtuality continuum is the intermediate state in which the real environment is augmented with virtual content.",
      "from_lecture": "1"
     },
     {
      "concept": "C0004",
      "prompt": "What is mixed reality (MR)?",
      "answer": "Mixed reality, in a broad sense, is the entire space between the real environment extreme and the virtual environment extreme of the reality-virtuality continuum, containing different degrees of augmentation of the real environment with virtual content and of the virtual environment with real content.",
      "from_lecture": "1"
     },
     {
      "concept": "C0001",
      "prompt": "What is extended reality (XR)?",
      "answer": "Extended Reality (XR) is an umbrella term, not a specific technology, that covers all present or future immersive technologies, such as augmented reality (AR), virtual reality (VR), and mixed reality (MR).",
      "from_lecture": "1"
     },
     {
      "concept": "C1324",
      "prompt": "What is internet of things (IoT)?",
      "answer": "In the development of computer systems, people have tried to make technology disappear from the user's point of view, and the current stage defined by popular technological products such as wearable devices, mobile devices, flexible devices, and connected devices is referred to as Internet of Things (IoT) or ubiquitous computing, in which users are surrounded by multiple connected computers that can communicate with each other without the user separately operating them, moving toward making technology disappear.",
      "from_lecture": "23"
     }
    ]
   },
   "facts": [
    "1/S2/F1",
