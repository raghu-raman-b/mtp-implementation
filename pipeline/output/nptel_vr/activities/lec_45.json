   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C1255",
      "prompt": "What is prototype?",
      "answer": "The design-prototype-evaluate cycle in experience design consists of designing, quickly prototyping the design, evaluating it, finding problems, refining the design, and repeating this with new prototypes and evaluations, which may require many cycles before the design is stabilized.",
      "from_lecture": "42"
     },
     {
      "concept": "C0241",
      "prompt": "What is usability?",
      "answer": "Usability is an explicit measure of how good a system is from the point of view of the user.",
      "from_lecture": "24"
     },
     {
      "concept": "C1754",
      "prompt": "What is user feedback?",
      "answer": "In an interactive system development lifecycle, iterations between stages are intended to account for user feedback, where user feedback means involving users in different ways, not only through feedback.",
      "from_lecture": "32"
     },
     {
      "concept": "C1764",
      "prompt": "What is code testing?",
      "answer": "Coding and code testing in interactive system development are carried out in the traditional software engineering way, through code design, then coding and implementation, then code testing.",
      "from_lecture": "32"
     },
     {
      "concept": "C1765",
      "prompt": "What is empirical study?",
      "answer": "The iterative software development life cycle has three evaluation points: early evaluation, which quickly evaluates interface and interaction design ideas with fewer resources and less time as part of the design-prototype-evaluate cycle; code testing, which evaluates the code as part of coding and implementation; and empirical study.",
      "from_lecture": "32"
     }
    ]
   },
