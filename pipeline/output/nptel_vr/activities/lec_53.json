 "lecture": "53",
 "activities": [
  {
   "id": "53/A0",
   "kind": "recall",
   "scope": "lecture",
   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C1232",
      "prompt": "What is node?",
      "answer": "A scene graph is a node-based graph, essentially a tree of nodes and links, that represents a computer graphics scene, allowing selective work with nodes to manipulate the scene, create realistic effects, and support interaction, thereby providing a way to manage the functionality of a complex graphics application.",
      "from_lecture": "21"
     },
     {
      "concept": "C2696",
      "prompt": "What is time threshold (TTH)?",
      "answer": "A time-constrained virtual tour optimization approach seeks an optimal path that covers the maximum number of points of interest (POIs) while completing within the time threshold (TTH).",
      "from_lecture": "52"
     },
     {
      "concept": "C2712",
      "prompt": "What is vehicle routing problem with profit (VRPP)?",
      "answer": "Vehicle routing problem with profit (VRPP) is a generalization of the vehicle routing problem (VRP), an operations research problem, in which not all nodes must be visited and the route maximizes profit within a time constraint, and in this formulation profit is the importance of the nodes.",
      "from_lecture": "52"
     },
     {
      "concept": "C0002",
      "prompt": "What is virtual reality (VR)?",
      "answer": "Virtual reality (VR) is, according to the Miriam Webster dictionary, an artificial environment experienced through sensory stimuli, in which sights and sounds play a primary role and are provided by a computer, possibly along with other sensory stimuli, and in which a person's actions partially determine what happens in the environment.",
      "from_lecture": "4"
     },
     {
      "concept": "C0358",
      "prompt": "What is cybersickness (CS)?",
      "answer": "Cybersickness (CS), also known in the literature as visually induced motion sickness (VIMS), is a condition that can affect individuals when they interact with virtual reality (VR) technology and is primarily relevant to virtual reality.",
      "from_lecture": "10"
     },
     {
      "concept": "C0044",
      "prompt": "What is virtual tour?",
      "answer": "Experiencing heritage in the virtual reality (VR) system for Majuli River Island is intended as an immersive virtual tour or exploration of Majuli River Island that uses the archive of heritage information.",
      "from_lecture": "33"
     }
    ]
   },
