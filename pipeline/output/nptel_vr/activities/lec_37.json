{
 "lecture": "37",
 "activities": [
  {
   "id": "37/A0",
   "kind": "recall",
   "scope": "lecture",
   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C1772",
      "prompt": "What is contextual inquiry (CI)?",
      "answer": "Contextual inquiry is one of many methods for gathering end-user requirements, which in the context of usability requirement gathering are treated as usability requirements.",
      "from_lecture": "35"
     },
     {
      "concept": "C1771",
      "prompt": "What is requirement?",
      "answer": "A design recommendation such as providing an erase-content facility in the class note-taking application for correcting mistakes is a requirement, not a prescription for implementation; it states what must be done to make the system usable, and it does not specify how to implement it.",
      "from_lecture": "36"
     },
     {
      "concept": "C1945",
      "prompt": "What is design recommendation?",
      "answer": "After the finished affinity diagram is drawn, reflection means deciding what to do with the data and formulating a set of design recommendations based on the data.",
      "from_lecture": "36"
     },
     {
      "concept": "C0002",
      "prompt": "What is virtual reality (VR)?",
      "answer": "Virtual reality (VR) is, according to the Miriam Webster dictionary, an artificial environment experienced through sensory stimuli, in which sights and sounds play a primary role and are provided by a computer, possibly along with other sensory stimuli, and in which a person's actions partially determine what happens in the environment.",
      "from_lecture": "4"
     },
     {
      "concept": "C0324",
      "prompt": "What is presence?",
      "answer": "Presence is the psychological side that captures whether a user perceives the immersive qualities that are generated.",
      "from_lecture": "8"
     },
     {
      "concept": "C0358",
      "prompt": "What is cybersickness (CS)?",
      "answer": "Cybersickness (CS), also known in the literature as visually induced motion sickness (VIMS), is a condition that can affect individuals when they interact with virtual reality (VR) technology and is primarily relevant to virtual reality.",
      "from_lecture": "10"
     }
    ]
   },
