{
 "lecture": "52",
 "activities": [
  {
   "id": "52/A0",
   "kind": "recall",
   "scope": "lecture",
   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C2637",
      "prompt": "What is natural walking model?",
      "answer": "The natural walking model for a system-controlled virtual reality (VR) tour is intended to provide a realistic walking experience by displaying a visual speed, or optic flow (the rate at which scenes change in the virtual world), that matches the user's perceived instantaneous walking speed, producing the perception of movement.",
      "from_lecture": "51"
     },
     {
      "concept": "C2646",
      "prompt": "What is travel time?",
      "answer": "The first stage of the travel-time algorithm is to compute the time to travel between two directly connected nodes using the natural walking-speed model.",
      "from_lecture": "51"
     },
     {
      "concept": "C2656",
      "prompt": "What is vertex set?",
      "answer": "The virtual world part of a virtual experience is represented as a weighted graph G = (V, E), where V is the vertex set of all points of interest (POIs) and E is the set of weighted edges between POIs, representing a top view of the virtual world.",
      "from_lecture": "51"
     },
     {
      "concept": "C2659",
      "prompt": "What is edge weight?",
      "answer": "For every pair of vertices v1 and v2 in the vertex set V, the assigned edge weight is the Euclidean distance between v1 and v2 if they are directly connected, and a very large number represented by the infinity symbol if they are not directly connected.",
      "from_lecture": "51"
     },
     {
      "concept": "C2676",
      "prompt": "What is complete graph?",
      "answer": "The algorithm first converts the original graph G into a complete graph G' by keeping every directly connected edge unchanged and, for each pair of vertices that is not directly connected, adding a hypothetical edge whose length is the shortest path between those vertices in G.",
      "from_lecture": "51"
     },
     {
      "concept": "C2677",
      "prompt": "What is shortest path?",
      "answer": "The travelling salesman problem (TSP) asks, given a complete graph, for the shortest possible path that visits each node exactly once and returns to the starting node, where the shortest path is defined by the total weight of the edges in the path.",
      "from_lecture": "51"
     }
    ]
   },
