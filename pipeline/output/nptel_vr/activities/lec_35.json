   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C1362",
      "prompt": "What is user-centered design (UCD)?",
      "answer": "User-centered design is a design that results from applying a user-centric approach, and it involves users actively or passively in the design or development lifecycle used to build a usable software application.",
      "from_lecture": "24"
     },
     {
      "concept": "C1777",
      "prompt": "What is interface design?",
      "answer": "The design-prototype-evaluate loop includes the activities of interface design and interaction design, primarily designing the interface and interaction from the user's point of view based on user requirements, while code design is a separate later design activity.",
      "from_lecture": "32"
     },
     {
      "concept": "C1786",
      "prompt": "What is interactive system development lifecycle (ISDLC)?",
      "answer": "In the interactive system development lifecycle (ISDLC), building interactive software is broadly similar to building regular software, and the differences are in the requirement gathering, design-prototype-evaluate, and empirical study stages.",
      "from_lecture": "32"
     },
     {
      "concept": "C0241",
      "prompt": "What is usability?",
      "answer": "Usability is an explicit measure of how good a system is from the point of view of the user.",
      "from_lecture": "24"
     }
    ]
   },
