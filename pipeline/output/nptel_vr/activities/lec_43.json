   "scope": "lecture",
   "segment": null,
   "title": "Before you start: recall",
   "data": {
    "items": [
     {
      "concept": "C1255",
      "prompt": "What is prototype?",
      "answer": "The design-prototype-evaluate cycle in experience design consists of designing, quickly prototyping the design, evaluating it, finding problems, refining the design, and repeating this with new prototypes and evaluations, which may require many cycles before the design is stabilized.",
      "from_lecture": "42"
     },
     {
      "concept": "C2273",
      "prompt": "What is horizontal prototype?",
      "answer": "Prototypes can be broadly considered in two categories, horizontal prototypes and vertical prototypes.",
      "from_lecture": "42"
     },
     {
      "concept": "C2274",
      "prompt": "What is vertical prototype?",
      "answer": "Prototypes can be broadly considered in two categories, horizontal prototypes and vertical prototypes.",
      "from_lecture": "42"
     },
     {
      "concept": "C2277",
      "prompt": "What is low-fidelity prototype?",
      "answer": "A low-fidelity prototype is a prototype created without technological intervention, programming, code, or a computer, using non-digital materials such as paper, cardboard, or wood, and paper mockups of the look, feel, and functionality of an interface are a popular example.",
      "from_lecture": "42"
     },
     {
      "concept": "C2281",
      "prompt": "What is storyboard?",
      "answer": "To represent interaction, a low-fidelity prototype needs a series of interface sketches rather than a single sketch, a practice often called storyboarding; a single sketch gives a horizontal prototype, whereas a series of sketches can give a vertical prototype depicting interaction.",
      "from_lecture": "42"
     },
     {
      "concept": "C2017",
      "prompt": "What is error prevention?",
      "answer": "The fifth rule in system design is to offer error prevention and simple error handling.",
      "from_lecture": "38"
     }
    ]
   },
